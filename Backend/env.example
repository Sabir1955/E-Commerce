# Environment & Server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# PostgreSQL Database Configuration (Primary Engine)
DATABASE_URL=postgresql://postgres:Postgres@localhost:5432/new1
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=Postgres
PGDATABASE=new1
PG_MAX_POOL_SIZE=20
PG_IDLE_TIMEOUT_MS=30000

# Legacy MongoDB Migration Reference (Migrated to PostgreSQL)
MONGODB_URI=

# Security & JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Initial Admin Seeding (npm run create-admin)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin123@gmail.com
ADMIN_MOBILE=+919876543210
ADMIN_PASSWORD=Admin@123456

# Order & Return Policies
RETURN_POLICY_DAYS=7

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Easebuzz Test Mode
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test
EASEBUZZ_BASE_URL=https://testpay.easebuzz.in

# Shiprocket Courier Integration
SHIPROCKET_EMAIL=shiprocket@example.com
SHIPROCKET_PASSWORD=replace-with-shiprocket-password
SHIPROCKET_PICKUP_LOCATION=Primary

# SMTP Email Notification Service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=notifications@example.com

# Twilio SMS / WhatsApp Notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_FROM_PHONE=+10000000000
TWILIO_WHATSAPP_FROM=+10000000000

# Application Payload Encryption (AES-256-GCM 32-byte / 64-char hex key)
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Allowed CORS Origins (comma-separated list of trusted origins)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000,http://localhost:3000

